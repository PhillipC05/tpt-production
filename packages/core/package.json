{
  "name": "@tpt/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "default": "./dist/pricing/index.js"
    },
    "./pricing/decay": {
      "types": "./dist/pricing/decay.d.ts",
      "default": "./dist/pricing/decay.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "default": "./dist/credits/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc -b ../types/tsconfig.json tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tpt/types": "workspace:*"
  }
}
