# =============================================================================
# TPT Production — Environment Variables Reference
# Copy this file to .env and fill in values. See docs/env.md for full details.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Dev uses SQLite (file path). Production must be PostgreSQL 16.
# See docs/deployment.md for migration instructions.
DATABASE_URL="file:../../packages/db/prisma/dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/tpt"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Production: redis://:password@redis:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret token for admin API endpoints (min 32 random characters in production)
ADMIN_API_TOKEN=""
# Secret for the admin Next.js app's server-side API calls
ADMIN_SECRET=""

# ── Storage (Cloudflare R2 or local filesystem) ───────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="tpt-designs"
# Leave R2_* empty to fall back to local disk storage
LOCAL_UPLOAD_DIR="./uploads"
LOCAL_UPLOAD_BASE_URL="http://localhost:8787"

# ── Stripe (required when ENABLE_PAYMENTS=true) ───────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Webhook signing (carrier / agent webhooks) ────────────────────────────────
WEBHOOK_SECRET=""

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_CREDITS=false
ENABLE_DRM=false
ENABLE_PAYMENTS=false
ENABLE_FREE_ECONOMY=true
ENABLE_PRICE_DECAY=false
ENABLE_AI_AGENTS=false
ENABLE_PRICE_QUERY_AUTH=false

# ── App URLs ──────────────────────────────────────────────────────────────────
# Build-time variable baked into Next.js bundles
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=8787
LOG_LEVEL="info"
ALLOWED_ORIGINS=""
