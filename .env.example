# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tpt"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"

# Storage (Cloudflare R2 or local)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="tpt-designs"
# Leave empty to use local disk storage instead of R2
STORAGE_LOCAL_PATH="./uploads"

# Stripe (required when ENABLE_PAYMENTS=true)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Feature flags
ENABLE_CREDITS=false
ENABLE_DRM=false
ENABLE_PAYMENTS=false
ENABLE_FREE_ECONOMY=true
ENABLE_PRICE_DECAY=false
ENABLE_AI_AGENTS=false

# App URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# Misc
NODE_ENV="development"
